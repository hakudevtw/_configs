# System ----------------------------------
# Runtime versions: mise (Brewfile, configs/mise.toml). Falls back to fnm until mise is installed.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
elif command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi


# zed
export PATH=$HOME/.local/bin:$PATH

# Terminal  -------------------------------
# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"

# Prompt: starship (Brewfile) replaces spaceship. Falls back to spaceship until starship is installed.
if command -v starship >/dev/null 2>&1; then
  ZSH_THEME=""
else
  ZSH_THEME="spaceship"
  [ -f "$HOME/.config/spaceship.zsh" ] && source "$HOME/.config/spaceship.zsh"
fi

# zsh-autosuggestions and zsh-syntax-highlighting are installed by Homebrew and sourced below
plugins=(git)

# Source Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Autosuggest settings
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#663399,standout"
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

# Source a zsh plugin from Homebrew, or from the old Oh My Zsh custom dir until it is migrated
_zsh_plugin() {
  local name=$1 f
  for f in "${HOMEBREW_PREFIX:-/opt/homebrew}/share/$name/$name.zsh" "$ZSH/custom/plugins/$name/$name.zsh"; do
    [ -f "$f" ] && { source "$f"; return; }
  done
}
_zsh_plugin zsh-autosuggestions

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=($HOME/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions


# Added by Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# bun
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Added by Antigravity IDE
export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"


# Added by Antigravity CLI installer
export PATH="$HOME/.local/bin:$PATH"

# _configs helpers (repo root resolved through the ~/.zshrc symlink)
_CONFIGS_ROOT="${${(%):-%x}:A:h:h}"
alias skill-add="$_CONFIGS_ROOT/scripts/skill-add.sh"
alias skill-update="$_CONFIGS_ROOT/scripts/skill-update.sh"
alias skill-list="$_CONFIGS_ROOT/scripts/list-skills.sh"

# Shell integrations (each only if installed)
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)

# Syntax highlighting must be sourced last
_zsh_plugin zsh-syntax-highlighting

# Machine overlay (secrets, per-machine env) — not in git, see local.zsh.example
[ -f "$HOME/.config/_configs/local.zsh" ] && source "$HOME/.config/_configs/local.zsh"
